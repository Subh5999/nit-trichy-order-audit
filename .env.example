# Local demo uses SQLite without setting DATABASE_URL.
# Optional: path for a separate local SQLite demo database.
# DEMO_DATABASE_PATH=backend/data/demo.sqlite3

# Required when DATABASE_URL is set. Use a private random value (32+ characters).
APP_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# Optional Supabase PostgreSQL connection string; apply the migration first.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
